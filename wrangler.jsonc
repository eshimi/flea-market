{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flea-market",
  "main": "src/worker.js",
  // デプロイの直前に、データの検証 → ページ生成 → サイトマップ（npm run build）
  "build": { "command": "npm run build" },
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // ドメインが決まったら routes を足す（要確認）。例: "routes": [{ "pattern": "example.jp", "custom_domain": true }]
}
